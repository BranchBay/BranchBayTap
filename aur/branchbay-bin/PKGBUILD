# Maintainer: BranchBay <contact@branchbay.dev>
pkgname=branchbay-bin
_version=1.0.8
pkgver=1.0.8
pkgrel=1
pkgdesc="Native Git client"
arch=('x86_64' 'aarch64')
url="https://branchbay.dev"
license=('LicenseRef-Proprietary')
depends=('gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'zlib')
optdepends=('vulkan-icd-loader: GPU rendering'
            'wayland: Wayland sessions')
provides=('branchbay')
conflicts=('branchbay' 'branchbay-bin' 'branchbay-beta-bin')
source_x86_64=("branch-bay-${_version}-linux-x86_64.tar.gz::https://releases.branchbay.dev/releases/${_version}/branch-bay-${_version}-linux-x86_64.tar.gz")
source_aarch64=("branch-bay-${_version}-linux-aarch64.tar.gz::https://releases.branchbay.dev/releases/${_version}/branch-bay-${_version}-linux-aarch64.tar.gz")
sha256sums_x86_64=('6ad657346bb581f3f086aee0ec8e8c1fcfad5fa56fa34e2c0f825cf67421ccfc')
sha256sums_aarch64=('59645a7806d692faf26f7746761af734c62021266e02dfbf7ca16bfc3c928340')

package() {
  cd "branch-bay-${_version}-linux-${CARCH}"
  install -Dm755 branch-bay "${pkgdir}/usr/bin/branch-bay"
  install -Dm644 branch-bay.desktop "${pkgdir}/usr/share/applications/branch-bay.desktop"
  local size
  for size in 32 48 128 256 512; do
    install -Dm644 "icons/hicolor/${size}x${size}/apps/branch-bay.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/branch-bay.png"
  done
}
